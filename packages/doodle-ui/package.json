{
  "name": "doodleui-react",
  "version": "0.8.0",
  "description": "Hand-drawn React component library with an Excalidraw-like sketch aesthetic",
  "license": "MIT",
  "author": "KanchanaSW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KanchanaSW/doodle-ui.git"
  },
  "bugs": {
    "url": "https://github.com/KanchanaSW/doodle-ui/issues"
  },
  "homepage": "https://doodle-ui.netlify.app",
  "keywords": [
    "react",
    "components",
    "sketch",
    "hand-drawn",
    "roughjs",
    "excalidraw",
    "ui",
    "mcp",
    "ai-agents"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "doodleui-react": "./dist/cli.js",
    "doodleui": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/styles.css",
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:registry": "tsx scripts/build-registry.ts",
    "audit:contrast": "tsx scripts/audit-contrast.ts",
    "build": "pnpm build:registry && tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "size:check": "tsx scripts/verify-treeshake.ts",
    "bench:render": "vitest run --config vitest.bench.config.ts",
    "clean": "rm -rf dist storybook-static coverage",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-hover-card": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "cmdk": "^1.0.4",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "embla-carousel-react": "^8.6.0",
    "execa": "^10.0.1",
    "framer-motion": "^13.3.0",
    "input-otp": "^1.4.2",
    "picocolors": "^1.1.1",
    "react-resizable-panels": "^2.1.7",
    "roughjs": "^4.6.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@doodle-ui/tsconfig": "workspace:*",
    "@size-limit/esbuild-why": "^14.0.0",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test": "8.6.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/diff": "^8.0.0",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^5.0.1",
    "chromatic": "^18.9.2",
    "jsdom": "^30.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.66.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^14.0.0",
    "storybook": "8.6.14",
    "tsup": "^8.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.4.1",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
