{
  "name": "doodleui-react",
  "version": "0.1.0",
  "description": "Hand-drawn React component library with an Excalidraw-like sketch aesthetic",
  "license": "MIT",
  "author": "KanchanaSW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KanchanaSW/doodle-ui.git"
  },
  "bugs": {
    "url": "https://github.com/KanchanaSW/doodle-ui/issues"
  },
  "homepage": "https://doodle-ui.netlify.app",
  "keywords": [
    "react",
    "components",
    "sketch",
    "hand-drawn",
    "roughjs",
    "excalidraw",
    "ui"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@doodle-ui/tsconfig": "workspace:*",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
